# Docker Environment Configuration
# Database Configuration for Docker
DATABASE_URL="postgresql://postgres:SecurePassword2025!@postgres:5432/npcl-auth-db-dev"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-here-make-it-long-and-random"
NEXTAUTH_URL="http://localhost:4000"

# JWT Configuration
JWT_EXPIRES_IN="7d"

# Email Configuration (Optional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# Redis Configuration (Performance Optimization)
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_URL="redis://redis:6379"

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING="true"
ENABLE_WEB_VITALS="true"

# Development Settings
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"

# Docker Database Configuration
POSTGRES_DB="npcl-auth-db-dev"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="SecurePassword2025!"

# Optional: External Services
# SENTRY_DSN="your-sentry-dsn"
# ANALYTICS_ID="your-analytics-id"